# Параметры БД. Используются и для локального запуска, и docker compose
# (compose подставляет их в postgres и в приложение).
DB_NAME=sql_trainer
DB_USER=postgres
DB_PASSWORD=postgres

# Локальный запуск без Docker (python app.py): нужен работающий Postgres.
# В docker compose эти два значения задаются в docker-compose.yml
# (DB_HOST=db, DB_PORT=5432), менять их здесь не нужно.
DB_HOST=localhost
DB_PORT=5432

# Порт на хосте для http://localhost:<APP_PORT> (только docker compose).
# Если 5000 занят (например, AirPlay на macOS) — поставь другой.
APP_PORT=5000
